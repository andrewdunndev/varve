#!/usr/bin/env bash
# Rebuild the lake from the mirror, one process per runtime, then swap.
# Run it as: bin/duck locked bin/build
#
#   1. each runtime's adapter writes its four tables into lake.new
#   2. a runtime that built owns its partitions, empty tables included. A runtime
#      that was not built keeps its last good partitions: one whose adapter
#      failed, one with an empty mirror (unless every session it published is
#      forgotten), and one not in runtimes.toml. Those partitions are copied
#      across, and so is every non-core folder (the mined tables)
#   3. the checks read lake.new against the published lake
#   4. lake.new replaces lake by rename, then the mines run; the previous lake
#      stays as lake.old until the next build starts, so a bad swap can be undone
# A bound hit (exit 1 from bin/duck) abandons the whole build and leaves the
# lake untouched. Exit 1 also means a check failed, which leaves the lake
# untouched, or a runtime failed, which swaps the rest in and then exits 1.
set -euo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
data="${VARVE_DATA:-$HOME/.local/share/varve}"
mirror="${VARVE_MIRROR:-$data/mirror}"
lake="${VARVE_LAKE:-$data/lake}"
new="$lake.new"
old="$lake.old"
tables="sessions messages api_calls tool_calls"
die() { echo "varve: build: $*" >&2; exit 2; }

if [ -d "$old" ] && [ ! -d "$lake" ]; then mv "$old" "$lake"; fi
rm -rf "$old"

for f in runtimes attribution pricing; do
  [ -f "$data/$f.toml" ] || die "no $data/$f.toml (copy the matching *.example.toml there and edit)"
done
yq="$("$repo/bin/tool" yq)" || exit 2

rm -rf "$new"
mkdir -p "$new"

failed=""
built=" "
dropped=" "
rows="$("$yq" -p toml -o=tsv '(.row // [])[] | [.name, .adapter]' "$data/runtimes.toml")"
while IFS=$'\t' read -r name adapter; do
  [ -n "$name" ] || continue
  dir="$mirror/$name"
  if [ ! -d "$dir" ] || [ -z "$(find "$dir" -type f -print -quit)" ]; then
    left=1
    if [ -d "$lake/sessions" ]; then
      left="$(VARVE_LAKE="$lake" "$repo/bin/duck" "build $name" -noheader -list \
        -c "CREATE VIEW IF NOT EXISTS forgotten AS SELECT NULL::VARCHAR AS session_id WHERE false;" \
        -c "SELECT count(*) FROM sessions WHERE runtime = '$name' AND session_id NOT IN (SELECT session_id FROM forgotten);")" || left=1
    fi
    if [ "$left" = 0 ]; then
      echo "varve: build $name: empty mirror and every published session is forgotten, dropping its partitions" >&2
      dropped="$dropped$name "
    else
      echo "varve: build $name: empty mirror at $dir, keeping its published partitions" >&2
    fi
    continue
  fi
  file="$data/adapters/$adapter"
  [ -f "$file" ] || file="$repo/adapters/$adapter"
  [ -f "$file" ] || die "$name: no adapter $adapter in $data/adapters or $repo/adapters"
  args=(-c "SET VARIABLE mirror_dir='$dir'" -f "$repo/sql/prelude.sql" -f "$file")
  for t in $tables; do
    args+=(-c "COPY (SELECT * FROM stg_$t ANTI JOIN forgotten USING (session_id)) TO '$new/$t' (FORMAT parquet, PARTITION_BY (runtime, date), FILENAME_PATTERN 'part', OVERWRITE_OR_IGNORE, COMPRESSION zstd);")
  done
  rc=0
  VARVE_LAKE="$new" "$repo/bin/duck" "build $name" "${args[@]}" || rc=$?
  if [ "$rc" -eq 1 ]; then rm -rf "$new"; exit 1; fi
  if [ "$rc" -ne 0 ]; then
    for t in $tables; do rm -rf "$new/$t/runtime=$name"; done
    echo "varve: build $name: adapter failed, keeping its published partitions" >&2
    failed="$failed $name"
  else
    built="$built$name "
  fi
done <<< "$rows"

if [ -d "$lake" ]; then
  for d in "$lake"/*/; do
    [ -d "$d" ] || continue
    t="$(basename "$d")"
    case " $tables " in
      *" $t "*)
        for p in "$d"runtime=*/; do
          [ -d "$p" ] || continue
          rn="$(basename "$p")"; rn="${rn#runtime=}"
          case "$built$dropped" in *" $rn "*) continue ;; esac
          if [ ! -d "$new/$t/$(basename "$p")" ]; then
            mkdir -p "$new/$t"
            cp -R "${p%/}" "$new/$t/"
          fi
        done ;;
      *)
        [ -d "$new/$t" ] || cp -R "${d%/}" "$new/" ;;
    esac
  done
fi

if ! VARVE_PUBLISHED="$lake" VARVE_LAKE="$new" "$repo/bin/check"; then
  rm -rf "$new"
  exit 1
fi

if [ -d "$lake" ]; then mv "$lake" "$old"; fi
mv "$new" "$lake"

just --justfile "$repo/justfile" mine
if [ -n "$failed" ]; then
  echo "varve: build: failed runtimes:$failed" >&2
  exit 1
fi
