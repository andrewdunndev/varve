#!/usr/bin/env bash
# One-shot migration (ADR-0011), deleted once run. Run it as: bin/duck locked bin/pack
#
#   bin/pack            retain the plain mirror in place: each runtime without a
#                       replace set gets manifest.parquet and lines/ beside its
#                       plain *.jsonl, compacted; a replace set gets NAME.zst
#                       beside its plain files. Nothing plain is touched.
#   bin/pack --verify   every plain file must reconstruct, from its lines, to the
#                       same sha256, every replace-set file must have an intact
#                       frame of the same bytes, and no plain file may lack a
#                       twin. Prints counts; exit 1 on any gap.
#
# MIRROR defaults to $VARVE_DATA/mirror. The operator deletes the plain files
# after --verify exits 0.
set -euo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
data="${VARVE_DATA:-$HOME/.local/share/varve}"
export VARVE_MIRROR="${MIRROR:-${VARVE_MIRROR:-$data/mirror}}"
mirror="$VARVE_MIRROR"
yq="$("$repo/bin/tool" yq)" || exit 2
[ -f "$data/runtimes.toml" ] || { echo "varve: pack: no $data/runtimes.toml" >&2; exit 2; }

if [ "${1:-pack}" != "--verify" ]; then
  exec "$repo/bin/sync" --from-mirror --compact
fi

zstd="$(command -v zstd)" || { echo "varve: zstd is not on PATH (install zstd)" >&2; exit 2; }
sum() { shasum -a 256 | cut -d' ' -f1; }

fail=0
"$repo/bin/sync" --from-mirror --verify || fail=1

# A replace set's plain files, each against the frame beside it.
plain=0; pairs=0; bad=0
while IFS=$'\t' read -r name replace; do
  [ -n "$name" ] && [ -n "$replace" ] || continue
  IFS=, read -r -a reps <<< "$replace"
  for r in "${reps[@]}"; do
    f="$mirror/$name/$r"
    [ -f "$f" ] || continue
    plain=$((plain + 1))
    if [ -f "$f.zst" ]; then
      pairs=$((pairs + 1))
      [ "$("$zstd" -dc -- "$f.zst" | sum)" = "$(sum < "$f")" ] || bad=$((bad + 1))
    fi
  done
done < <("$yq" -p toml -o=tsv '(.row // [])[] | [.name, ((.replace // []) | join(","))]' "$data/runtimes.toml")
if [ "$plain" -gt 0 ]; then
  echo "varve: pack verify: replace sets $pairs of $plain plain files have a frame, $((pairs - bad)) match" >&2
  if [ "$bad" -gt 0 ] || [ "$pairs" != "$plain" ]; then fail=1; fi
fi
exit "$fail"
